[Unit]
Description=OpenClaw Claw Default Tmux Control Backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStartPre=/bin/bash /root/.openclaw/skills/claw-remote/scripts/clear-claw-port.sh 18086
ExecStart=/usr/bin/python3 /root/.openclaw/skills/claw-remote/backend/claw-openclaw.py --tmux-socket /root/clawdbot-tmux-sockets/default-code.sock --host 127.0.0.1 --port 18086 --refresh 3
Restart=always
RestartSec=5
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
